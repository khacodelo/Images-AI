{
  "manifest_version": 3,
  "name": "AI Image Saver",
  "version": "1.4.0",
  "description": "Tạo ảnh AI bằng FLUX 3 Image Klein (qua Beeknoee API) với tùy chọn tỉ lệ, độ phân giải, định dạng ảnh và tự động lưu vào Tải xuống.",
  "minimum_chrome_version": "110",
  "permissions": ["storage", "downloads", "contextMenus", "activeTab", "scripting"],
  "host_permissions": ["https://platform.beeknoee.com/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Tạo ảnh AI", "default_popup": "popup.html" }
}
